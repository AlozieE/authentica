@model IEnumerable<Authentica_app.Models.VaultItem>
@{ ViewData["Title"] = "Vault Items"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@ViewBag.ItemType</h2>
    </div>
    @if (ViewBag.VaultId != null)
    {
        <a asp-action="Create" asp-route-vaultId="@ViewBag.VaultId" asp-route-type="@ViewBag.ItemType" class="btn btn-primary">+ Nieuw item</a>
    }
    else
    {
        <a asp-controller="Vault" asp-action="Index" class="btn btn-primary">+ Nieuw item</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Geen items gevonden. Voeg een nieuw item toe!</div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted"><small>Aangemaakt: @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@item.VaultItemId" class="btn btn-sm btn-outline-secondary">Bewerken</a>
                        <form asp-action="Delete" asp-route-id="@item.VaultItemId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Weet je het zeker?')">Verwijderen</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-secondary">← Terug naar vaults</a>
</div>