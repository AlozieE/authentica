@model IEnumerable<Authentica.BLL.Models.VaultItem>
@{ ViewData["Title"] = "Vault Items"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@ViewBag.ItemType</h2>
    </div>
    @if (ViewBag.VaultId != null)
    {
        <a asp-action="Create" asp-route-vaultId="@ViewBag.VaultId" asp-route-type="@ViewBag.ItemType" class="btn btn-primary">+ Nieuw item</a>
    }
    else
    {
        <a asp-controller="Vault" asp-action="Index" class="btn btn-primary">+ Nieuw item</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Geen items gevonden. Voeg een nieuw item toe!</div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted"><small>Aangemaakt: @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <a asp-action="Edit" asp-route-id="@item.VaultItemId" class="btn btn-sm btn-outline-secondary">Bewerken</a>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-id="@item.VaultItemId"
                                    onclick="copyItem(this)">Kopiëren</button>
                            <span class="text-success small" style="display:none">Gekopieerd!</span>
                        </div>
                        <form asp-action="Delete" asp-route-id="@item.VaultItemId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Weet je het zeker?')">Verwijderen</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-secondary">← Terug naar vaults</a>
</div>

<script>
    async function copyItem(btn) {
        try {
            const id = btn.dataset.id;
            const response = await fetch(`/VaultItem/GetDecryptedValue?id=${id}`);

            if (!response.ok) throw new Error('Request failed');

            const { value } = await response.json();
            await navigator.clipboard.writeText(value ?? '');

            const msg = btn.nextElementSibling;
            msg.style.display = 'inline';
            setTimeout(() => { msg.style.display = 'none'; }, 2000);
            setTimeout(() => { navigator.clipboard.writeText(''); }, 30000);
        } catch (e) {
            console.error('Kopiëren mislukt:', e);
        }
    }
</script>