@model Authentica.BLL.Models.Vault
@{ ViewData["Title"] = Model.Name; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Name</h2>
        <small class="text-muted">Aangemaakt: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Terug naar vaults</a>
</div>

<div class="row g-3">

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">🔑 Wachtwoorden</span>
                <a asp-controller="VaultItem" asp-action="Create"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="1"
                   class="btn btn-sm btn-primary">+ Toevoegen</a>
            </div>
            <div class="card-body">
                <a asp-controller="VaultItem" asp-action="Index"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="1"
                   class="btn btn-sm btn-outline-secondary w-100">Bekijk alle wachtwoorden</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">💳 Creditcards</span>
                <a asp-controller="VaultItem" asp-action="Create"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="2"
                   class="btn btn-sm btn-primary">+ Toevoegen</a>
            </div>
            <div class="card-body">
                <a asp-controller="VaultItem" asp-action="Index"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="2"
                   class="btn btn-sm btn-outline-secondary w-100">Bekijk alle creditcards</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">📝 Beveiligde notities</span>
                <a asp-controller="VaultItem" asp-action="Create"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="3"
                   class="btn btn-sm btn-primary">+ Toevoegen</a>
            </div>
            <div class="card-body">
                <a asp-controller="VaultItem" asp-action="Index"
                   asp-route-vaultId="@Model.VaultId"
                   asp-route-vaultItemTypeId="3"
                   class="btn btn-sm btn-outline-secondary w-100">Bekijk alle notities</a>
            </div>
        </div>
    </div>

</div>
