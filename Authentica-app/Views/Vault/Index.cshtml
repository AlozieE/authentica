@model IEnumerable<Authentica_app.Models.Vault>
@{ ViewData["Title"] = "My Vaults"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mijn Vaults</h2>
        <a asp-action="Create" class="btn btn-primary">+ Niewe Vault</a>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info">Je hebt nog geen kluizen. Maak er een aan om te beginnen!</div>
    }
    else
    {
        <div class="row">
            @foreach (var vault in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <a asp-controller="VaultItem" asp-action="Index" asp-route-vaultId="@vault.VaultId" asp-route-type="Password" class="text-decoration-none text-dark">
                            <div class="card-body">
                                <a asp-action="Details" asp-route-id="@vault.VaultId" class="text-decoration-none text-dark">
                                    <h5 class="card-title">@vault.Name</h5>
                                </a>
                                <p class="card-text text-muted"><small>Aangemaakt: @vault.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></p>
                                <div class="d-flex gap-2 mt-3">
                                    <a asp-controller="VaultItem" asp-action="Index" asp-route-vaultId="@vault.VaultId" asp-route-type="Password" class="btn btn-sm btn-outline-primary">Wachtwoorden</a>
                                    <a asp-controller="VaultItem" asp-action="Index" asp-route-vaultId="@vault.VaultId" asp-route-type="CreditCard" class="btn btn-sm btn-outline-primary">Creditcards</a>
                                    <a asp-controller="VaultItem" asp-action="Index" asp-route-vaultId="@vault.VaultId" asp-route-type="SecureNote" class="btn btn-sm btn-outline-primary">Notities</a>
                                </div>
                            </div>
                        </a>
                        <div class="card-footer d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@vault.VaultId" class="btn btn-sm btn-outline-secondary">Bewerken</a>
                            <form asp-action="Delete" asp-route-id="@vault.VaultId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Weet je het zeker?')">Verwijderen</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>