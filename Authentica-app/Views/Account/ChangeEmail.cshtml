@model Authentica_app.Models.ChangeEmailViewModel
@{
    ViewData["Title"] = "E-mailadres wijzigen";
}

<style>
    .account-card {
        background: white;
        border-radius: 12px;
        padding: 32px;
        max-width: 480px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }

    .account-card h2 {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .account-card > p {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 24px;
    }

    .current-email-badge {
        display: inline-block;
        background: #f3f4f6;
        color: #374151;
        font-size: 13px;
        font-weight: 500;
        padding: 6px 12px;
        border-radius: 8px;
        margin-bottom: 24px;
    }

    .current-email-badge span {
        font-weight: 700;
        color: #1a1a2e;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        color: #1a1a2e;
        box-sizing: border-box;
        transition: border-color .15s;
    }

    .form-input:focus {
        outline: none;
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79,70,229,.1);
    }

    .btn-primary-acct {
        background: #4f46e5;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        margin-top: 4px;
    }

    .btn-primary-acct:hover { background: #4338ca; }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .alert-error ul { margin: 0; padding-left: 18px; }
</style>

<div class="account-card">
    <h2>E-mailadres wijzigen</h2>
    <p>Voer een nieuw e-mailadres in voor je account.</p>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage as string))
    {
        <div class="alert-success">@ViewBag.SuccessMessage</div>
    }

    <div class="current-email-badge">Huidig: <span>@ViewBag.CurrentEmail</span></div>

    <div asp-validation-summary="All" class="alert-error"></div>

    <form asp-action="ChangeEmail" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="NewEmail"></label>
            <input asp-for="NewEmail" class="form-input" type="email" autocomplete="email" />
        </div>

        <button type="submit" class="btn-primary-acct">E-mailadres wijzigen</button>
    </form>
</div>
