@{ ViewData["Title"] = "Nieuw item"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Nieuw @ViewBag.ItemType</h2>
    <a asp-action="Index" asp-route-vaultId="@ViewBag.Vault.VaultId" asp-route-type="@ViewBag.ItemType" class="btn btn-outline-secondary">← Terug</a>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <form asp-action="Create" asp-route-vaultId="@ViewBag.Vault.VaultId" asp-route-type="@ViewBag.ItemType" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Titel</label>
                <input name="Title" class="form-control" required />
            </div>

            @if (ViewBag.ItemType == Authentica_app.BLL.Models.VaultItemType.Password)
            {
                <div class="mb-3">
                    <label class="form-label">Website</label>
                    <input name="Website" class="form-control" placeholder="https://example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Gebruikersnaam</label>
                    <input name="Username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Wachtwoord</label>
                    <div class="input-group">
                        <input name="Password" id="passwordField" type="password" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()" id="togglePasswordBtn" title="Toon/verberg wachtwoord">👁</button>
                        <input type="number" id="passwordLength" class="form-control" style="max-width: 80px;" value="16" min="8" max="64" title="Lengte" />
                        <button type="button" class="btn btn-outline-secondary" onclick="generatePassword()">Genereer</button>
                    </div>
                </div>

                <script>
                    function togglePassword() {
                        const field = document.getElementById('passwordField');
                        field.type = field.type === 'password' ? 'text' : 'password';
                    }

                    function generatePassword() {
                        const length = parseInt(document.getElementById('passwordLength').value, 10);
                        if (length < 8) {
                            alert('Wachtwoordlengte moet minimaal 8 zijn.');
                            return;
                        }
                        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@@#$%^&*()_+-=[]{}|;:,.<>?';
                        let password = '';
                        for (let i = 0; i < length; i++) {
                            password += chars.charAt(Math.floor(Math.random() * chars.length));
                        }
                        const field = document.getElementById('passwordField');
                        field.value = password;
                        field.type = 'text';
                    }
                </script>
            }
            else if (ViewBag.ItemType == Authentica_app.BLL.Models.VaultItemType.CreditCard)
            {
                <div class="mb-3">
                    <label class="form-label">Kaarthouder</label>
                    <input name="CardHolder" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Kaartnummer</label>
                    <input name="CardNumber" class="form-control" placeholder="1234 5678 9012 3456" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Vervaldatum</label>
                    <input name="ExpiryDate" class="form-control" placeholder="MM/JJ" />
                </div>
                <div class="mb-3">
                    <label class="form-label">CVC</label>
                    <input name="CVC" class="form-control" placeholder="123" />
                </div>
            }
            else if (ViewBag.ItemType == Authentica_app.BLL.Models.VaultItemType.SecureNote)
            {
                <div class="mb-3">
                    <label class="form-label">Inhoud</label>
                    <textarea name="Content" class="form-control" rows="5"></textarea>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Opslaan</button>
                <a asp-action="Index" asp-route-vaultId="@ViewBag.Vault.VaultId" asp-route-type="@ViewBag.ItemType" class="btn btn-outline-secondary">Annuleren</a>
            </div>
        </form>
    </div>
</div>